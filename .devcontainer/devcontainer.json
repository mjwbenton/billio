{
  "name": "Billio",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:24",
  "features": {
    "ghcr.io/devcontainers/features/aws-cli:1": {}
  },
  "containerEnv": {
    "AGENT_BROWSER_EXECUTABLE_PATH": "/usr/bin/chromium",
    "AGENT_BROWSER_ARGS": "--no-sandbox,--disable-dev-shm-usage"
  },
  "initializeCommand": "keeenv --config packages/graphql/.keeenv eval | sed 's/^export //' > packages/graphql/.env",
  "postCreateCommand": "sudo corepack enable && COREPACK_ENABLE_DOWNLOAD_PROMPT=0 yarn install --frozen-lockfile",
  "forwardPorts": [3000, 4000],
  "portsAttributes": {
    "3000": {
      "label": "Admin UI"
    },
    "4000": {
      "label": "GraphQL Server"
    }
  },
  "remoteEnv": {
    "AWS_SDK_LOAD_CONFIG": "1"
  },
  "remoteUser": "node"
}
